# ============================================================
# ApexCart AI — Environment Configuration
# Copy this file to .env and fill in your API keys.
# ============================================================

# ----------------------------------------------------------------
# Google Gemini LLM (Required for LLM-powered agent responses)
# Get your key at: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------------
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ----------------------------------------------------------------
# Tavily Web Search (Optional — fallback mock data used if absent)
# Get your key at: https://tavily.com
# ----------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here

# ----------------------------------------------------------------
# Application Settings (leave defaults unless you change ports)
# ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:5173
